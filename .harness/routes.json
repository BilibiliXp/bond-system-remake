    {
      "id": "fallback",
      "intent": "任务无法匹配其他路由时的保守入口。",
      "keywords": [],
      "required": [
        {
          "doc_id": "harness.manifest",
          "read": "full"
        }
      ],
      "conditional": [],
      "artifacts": [],
      "search_paths": [
        ".harness/manifest.json"
      ],
      "do_not_read": [
        "hero_icon",
        "item_icon",
        "res"
      ],
      "stop_and_ask_when": "清单中有两个以上可能的权威领域，且选择不同领域会改变结论或修改范围。"
