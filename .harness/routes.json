    {
      "id": "feature_change",
      "intent": "实现一个尚未被更具体路由覆盖的游戏功能。",
      "keywords": [
        "新增功能",
        "实现",
        "修改功能",
        "接入",
        "扩展"
      ],
      "required": [
        {
          "doc_id": "project.demo-readme",
          "read": "sections",
          "sections": [
            "Demo 目标",
            "当前不实现",
            "后续可扩展位置"
          ]
        }
      ],
      "conditional": [
        {
          "when": "功能改变羁绊规则",
          "doc_id": "gameplay.bond-spec",
          "read": "full"
        },
        {
          "when": "功能改变升级或叠加",
          "doc_id": "gameplay.card-upgrade-demo",
          "read": "full"
        },
        {
          "when": "功能使用具体卡牌或数值",
          "doc_id": "data.balance-readable",
          "read": "lookup",
          "locator": "按名称或触发时机检索；修改正式数据时直接更新本文件"
        }
      ],
      "artifacts": [
        {
          "artifact_id": "implementation.app",
          "when": "总是"
        },
        {
          "artifact_id": "implementation.data-copy",
          "when": "功能使用网页卡牌数据或交互元数据"
        },
        {
          "artifact_id": "implementation.page",
          "when": "功能需要新页面结构"
        },
        {
          "artifact_id": "implementation.styles",
          "when": "功能需要新视觉表现"
        }
      ],
      "search_paths": [
        "README.md",
        "游戏数据速查.md",
        "技能结算规则.md",
        "羁绊系统说明.md",
        "卡牌升级规则.md",
        "app.js",
        "game-data.js",
        "index.html",
        "styles.css"
      ],
      "do_not_read": []
